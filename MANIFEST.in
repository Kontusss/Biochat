# MANIFEST.in

# Include all python files from the biochat package
recursive-include biochat *.py

# Include the .pkl database files
recursive-include biochat/tool/schema_db *.pkl

# Include specific files from biochat_env, but not the biochat_tools subdirectory
recursive-include biochat_env *.py *.sh *.yml *.yaml *.txt *.md *.json *.R

# Exclude specific directories that are not part of the package
prune tutorials/data
prune biochat_env/biochat_tools

# Exclude build artifacts and caches
global-exclude *.py[co]
global-exclude __pycache__
global-exclude .ruff_cache
prune build
prune dist
prune *.egg-info

# Include other necessary files
include README.md
include LICENSE
include pyproject.toml
