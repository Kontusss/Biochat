# MANIFEST.in — sdist contents.
# The wheel is built from setuptools discovery restricted to `biochat*`
# (see pyproject.toml); the sdist adds only repository metadata files.

include README.md
include LICENSE
include pyproject.toml
include MANIFEST.in
include .env.example

# Package resources are declared via [tool.setuptools.package-data];
# nothing outside the biochat package tree is shipped.

global-exclude *.py[co]
global-exclude __pycache__
global-exclude .DS_Store
