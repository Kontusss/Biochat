# ============================================================
#  Biochat environment template
#  Copy to `.env` and fill in your own values:
#      cp .env.example .env
#  NEVER commit your real `.env`. This file contains only
#  placeholders — no credentials.
# ============================================================

# ── LLM provider ────────────────────────────────────────────
# Pick ONE provider key matching your model/source.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# Custom OpenAI-compatible endpoints (DeepSeek, vLLM, ...):
# CUSTOM_MODEL_BASE_URL=https://api.deepseek.com/v1
# CUSTOM_MODEL_API_KEY=your-key-here

# ── Model selection ─────────────────────────────────────────
# BIOCHAT_LLM=claude-sonnet-4-5
# LLM_SOURCE=Anthropic            # optional; auto-detected otherwise
# BIOCHAT_TEMPERATURE=0.7
# BIOCHAT_MAX_TOKENS=8192

# ── Data & runtime ──────────────────────────────────────────
# BIOCHAT_DATA_PATH=./data        # local data-lake directory (~11GB)
# BIOCHAT_TIMEOUT_SECONDS=600     # per-request agent timeout
# BIOCHAT_RECURSION_LIMIT=500     # LangGraph recursion limit
# BIOCHAT_TOOL_PROFILE=full       # full | minimal

# ── Security policy (read carefully) ────────────────────────
# Host code execution (Python/R/Bash on YOUR machine) is DISABLED by
# default because generated code runs unsandboxed. Only enable if you
# fully trust the workload and understand the risk:
# BIOCHAT_ALLOW_HOST_CODE_EXECUTION=false

# UI access codes (comma-separated). Leave unset to allow passwordless
# LOOPBACK use; remote binds require codes or the explicit acknowledgement
# below. Never reuse an example value.
# BIOCHAT_ACCESS_CODE=set-your-own-secret-code

# Unauthenticated remote exposure must be explicitly acknowledged.
# Keep false unless you accept an open, unauthenticated bind.
BIOCHAT_ALLOW_UNAUTHENTICATED_REMOTE=false

# Launch binding: keep loopback for workstation use.
# BIOCHAT_HOST=127.0.0.1

# ── Third-party integrations ────────────────────────────────
# PROTOCOLS_IO_ACCESS_TOKEN=
# SYNAPSE_AUTH_TOKEN=
