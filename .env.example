# ============================================================
# Biochat Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual API keys:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# NEVER hardcode API keys in shell scripts or source code.
# ============================================================

# ── Anthropic (Claude models) ────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── OpenAI (GPT models) ──────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Azure OpenAI ─────────────────────────────────────────────
# OPENAI_API_KEY=your_azure_api_key_here
# OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# ── Google Gemini ────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq ─────────────────────────────────────────────────────
# GROQ_API_KEY=your_groq_api_key_here

# ── AWS Bedrock ──────────────────────────────────────────────
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_token_here
# AWS_REGION=us-east-1

# ── Custom Model Serving (e.g., DeepSeek, SGLang, vLLM) ──────
# LLM_SOURCE=Custom
# CUSTOM_MODEL_BASE_URL=https://api.deepseek.com/v1
# CUSTOM_MODEL_API_KEY=your_custom_api_key_here

# ── LLM Configuration ────────────────────────────────────────
# BIOCHAT_LLM=claude-sonnet-4-5         # Model name
# BIOCHAT_SOURCE=Anthropic              # Provider: OpenAI | Anthropic | Gemini | Groq | Custom | ...
# BIOCHAT_TEMPERATURE=0.7               # Generation temperature
# BIOCHAT_TIMEOUT_SECONDS=600           # Code execution timeout
# BIOCHAT_USE_TOOL_RETRIEVER=true       # Enable tool retrieval
# BIOCHAT_COMMERCIAL_MODE=false         # Exclude non-commercial datasets

# ── Data Path ────────────────────────────────────────────────
# BIOCHAT_DATA_PATH=./data              # Data lake location (~11GB)

# ── UI Access Code (optional) ─────────────────────────────────
# BIOCHAT_ACCESS_CODE=Biochat2025       # Leave empty to disable verification

# ── Antibody diffusion model (Phase 3B, optional) ────────────
# DiffCDRH3 weights: cdrh3_vae_model_best.pth / epitope_evo_vae_model_best.pth / diff_cdrh3_best_model_unfrozen.pth
# BIOMNI_ANTIBODY_MODEL_DIR=/path/to/weights
